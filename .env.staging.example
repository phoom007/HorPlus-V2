# HorPlus-V2 Staging Environment Variables Template
NODE_ENV=production
PORT=3000
API_BASE_PATH=/api/v1
DATABASE_URL=postgresql://staging_user:STAGING_DB_PASSWORD@staging-db.internal:5432/horplus_staging?sslmode=require
REDIS_URL=rediss://default:STAGING_REDIS_PASSWORD@staging-redis.internal:6379
LOG_LEVEL=info
CORS_ORIGINS=https://staging.horplus.com,https://app-staging.horplus.com
BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=10000

# Auth & Session Configuration
GOOGLE_CLIENT_ID=STAGING_GOOGLE_CLIENT_ID.apps.googleusercontent.com
SESSION_ENCRYPTION_KEY=STAGING_SESSION_ENCRYPTION_KEY_MUST_BE_MIN_32_CHARS
SESSION_TTL_SECONDS=86400
SESSION_COOKIE_NAME=horplus_staging_session
CSRF_SIGNING_KEY=STAGING_CSRF_SIGNING_KEY_MIN_16_CHARS
CSRF_COOKIE_NAME=horplus_staging_csrf
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
TRUST_PROXY=true

# Field Encryption
FIELD_ENCRYPTION_KEY=STAGING_FIELD_ENCRYPTION_KEY_MUST_BE_MIN_32_CHARS
FIELD_ENCRYPTION_KEY_VERSION=1


# Storage & File Configuration
STORAGE_PROVIDER=s3
S3_BUCKET_NAME=horplus-staging-assets
S3_REGION=ap-southeast-1
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
PUBLIC_SLIP_BASE_URL=https://api-staging.horplus.com/api/v1/public/slips
