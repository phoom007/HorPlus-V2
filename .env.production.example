# HorPlus-V2 Production Environment Variables Template
NODE_ENV=production
PORT=3000
API_BASE_PATH=/api/v1
DATABASE_URL=postgresql://prod_user:PROD_DB_PASSWORD@prod-db.internal:5432/horplus_prod?sslmode=require
REDIS_URL=rediss://default:PROD_REDIS_PASSWORD@prod-redis.internal:6379
LOG_LEVEL=info
CORS_ORIGINS=https://horplus.com,https://app.horplus.com,https://owner.horplus.com
BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=10000

# Auth & Session Configuration
GOOGLE_CLIENT_ID=PROD_GOOGLE_CLIENT_ID.apps.googleusercontent.com
SESSION_ENCRYPTION_KEY=PROD_SESSION_ENCRYPTION_KEY_MUST_BE_MIN_32_CHARS
SESSION_TTL_SECONDS=86400
SESSION_COOKIE_NAME=horplus_prod_session
CSRF_SIGNING_KEY=PROD_CSRF_SIGNING_KEY_MIN_16_CHARS
CSRF_COOKIE_NAME=horplus_prod_csrf
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
TRUST_PROXY=true

# Field Encryption
FIELD_ENCRYPTION_KEY=PROD_FIELD_ENCRYPTION_KEY_MUST_BE_MIN_32_CHARS
FIELD_ENCRYPTION_KEY_VERSION=1

# External Provider Credentials (Production Pilot)
LINE_CHANNEL_ID=PROD_LINE_CHANNEL_ID
LINE_CHANNEL_SECRET=PROD_LINE_CHANNEL_SECRET
LINE_CHANNEL_ACCESS_TOKEN=PROD_LINE_CHANNEL_ACCESS_TOKEN
LINE_LIFF_ID=PROD_LINE_LIFF_ID
SLIPOK_API_KEY=PROD_SLIPOK_API_KEY
SLIPOK_BRANCH_ID=PROD_SLIPOK_BRANCH_ID
SLIPOK_API_URL=https://api.slipok.com/api/line/apikey

# Storage & File Configuration
STORAGE_PROVIDER=s3
S3_BUCKET_NAME=horplus-prod-assets
S3_REGION=ap-southeast-1
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
PUBLIC_SLIP_BASE_URL=https://api.horplus.com/api/v1/public/slips
