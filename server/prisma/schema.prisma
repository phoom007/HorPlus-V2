  processedAt       DateTime? @map("processed_at") @db.Timestamptz()

  dormitory Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)

  @@index([dormitoryId, status])
  @@index([status, createdAt])
  @@map("local_notification_outbox")
}

model StaffNotification {
  id             String    @id @default(uuid()) @db.Uuid
  dormitoryId    String    @map("dormitory_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  roleCode       String?   @map("role_code") @db.VarChar(50)
  category       String    @db.VarChar(100)
  title          String    @db.VarChar(255)
  message        String    @db.Text
  metadata       Json?     @map("metadata")
  isRead         Boolean   @default(false) @map("is_read")
  readAt         DateTime? @map("read_at") @db.Timestamptz()
  isDismissed    Boolean   @default(false) @map("is_dismissed")
  dismissedAt    DateTime? @map("dismissed_at") @db.Timestamptz()
  sourceOutboxId String?   @map("source_outbox_id") @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  dormitory Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)

  @@unique([sourceOutboxId, userId], name: "staff_notice_source_outbox_user_unique", map: "staff_notice_source_outbox_user_unique")
  @@index([dormitoryId, userId, isRead])
  @@index([dormitoryId, userId, isDismissed])
  @@index([userId, isRead])
  @@map("staff_notices")
}

model UserReferralCode {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid
  code       String   @unique @db.VarChar(6)
  maxUsage   Int      @default(10) @map("max_usage")
  usageCount Int      @default(0) @map("usage_count")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  attributions ReferralAttribution[]

  @@map("user_referral_codes")
}

model ReferralAttribution {
  id                     String    @id @default(uuid()) @db.Uuid
  inviteeUserId          String    @unique @map("invitee_user_id") @db.Uuid
  inviterUserId          String    @map("inviter_user_id") @db.Uuid
  referralCodeId         String    @map("referral_code_id") @db.Uuid
  referralCodeSnapshot   String    @map("referral_code_snapshot") @db.VarChar(6)
  status                 String    @default("PENDING") @db.VarChar(50) // PENDING, QUALIFIED, VOIDED
  provisionalCoinGranted Int       @default(10) @map("provisional_coin_granted")
  dormitoryId            String?   @map("dormitory_id") @db.Uuid
  qualifiedAt            DateTime? @map("qualified_at") @db.Timestamptz()
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  invitee      User             @relation("InviteeAttribution", fields: [inviteeUserId], references: [id], onDelete: Restrict)
  inviter      User             @relation("InviterAttributions", fields: [inviterUserId], references: [id], onDelete: Restrict)
  referralCode UserReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Restrict)
  dormitory    Dormitory?       @relation(fields: [dormitoryId], references: [id], onDelete: SetNull)

  @@index([inviterUserId, status])
  @@map("referral_attributions")
}

model CoinWallet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  balance   Int      @default(0) @map("balance")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries CoinLedgerEntry[]

  @@map("coin_wallets")
}

model CoinLedgerEntry {
  id             String   @id @default(uuid()) @db.Uuid
  walletId       String   @map("wallet_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  entryType      String   @map("entry_type") @db.VarChar(50) // REFERRAL_INVITEE_CREDIT, REFERRAL_INVITER_CREDIT, SUBSCRIPTION_DEBIT, REVERSAL, ADMIN_ADJUSTMENT
  amount         Int      @map("amount") // + credit, - debit
  balanceAfter   Int      @map("balance_after")
  referenceType  String?  @map("reference_type") @db.VarChar(50)
  referenceId    String?  @map("reference_id") @db.VarChar(255)
  description    String?  @db.Text
  idempotencyKey String?  @unique @map("idempotency_key") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  wallet CoinWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("coin_ledger_entries")
}

model ReferralProgramConfig {
  id                   String   @id @default(uuid()) @db.Uuid
  enabled              Boolean  @default(true)
  rewardCoin           Int      @default(10) @map("reward_coin")
  maxQualifiedInvitees Int      @default(10) @map("max_qualified_invitees")
  version              Int      @default(1)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("referral_program_configs")
}

// ==========================================
// LOCAL-07 Batch 02: Daily Stay & Invoicing Domain
// ==========================================

model DailyStay {
  id                    String    @id @default(uuid()) @db.Uuid
  dormitoryId           String    @map("dormitory_id") @db.Uuid
  roomId                String    @map("room_id") @db.Uuid
  tenantId              String?   @map("tenant_id") @db.Uuid
  occupancyId           String?   @map("occupancy_id") @db.Uuid
  requestSource         String    @default("OWNER") @map("request_source") @db.VarChar(50) // OWNER | TENANT
  applicantFullName     String?   @map("applicant_full_name") @db.VarChar(255)
  applicantPhone        String?   @map("applicant_phone") @db.VarChar(50)
  requesterUserId       String?   @map("requester_user_id") @db.Uuid
  startDate             DateTime  @map("start_date") @db.Date
  endDate               DateTime  @map("end_date") @db.Date
  checkInAt             DateTime? @map("check_in_at") @db.Timestamptz()
  checkOutAt            DateTime? @map("check_out_at") @db.Timestamptz()
  inclusiveDayCount     Int       @map("inclusive_day_count")
  dailyRateAmount       Decimal   @default(0.00) @map("daily_rate_amount") @db.Decimal(12, 2)
  totalRentAmount       Decimal   @default(0.00) @map("total_rent_amount") @db.Decimal(12, 2)
  depositAmount         Decimal   @default(0.00) @map("deposit_amount") @db.Decimal(12, 2)
  depositDeclaredStatus String    @default("UNPAID") @map("deposit_declared_status") @db.VarChar(50) // PAID | UNPAID
  status                String    @default("PENDING_APPROVAL") @db.VarChar(50) // PENDING_APPROVAL | RESERVED | ACTIVE | CHECKED_OUT | COMPLETED | CANCELLED | REJECTED
  approvedAt            DateTime? @map("approved_at") @db.Timestamptz()
  approvedByUserId      String?   @map("approved_by_user_id") @db.Uuid
  actualCheckedOutAt    DateTime? @map("actual_checked_out_at") @db.Timestamptz()
  checkedOutByUserId    String?   @map("checked_out_by_user_id") @db.Uuid
  version               Int       @default(1)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz()

  dormitory Dormitory         @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  room      Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tenant    Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  occupancy Occupancy?        @relation(fields: [occupancyId], references: [id], onDelete: SetNull)
  invoice   DailyStayInvoice?

  @@index([dormitoryId])
  @@index([roomId])
  @@index([tenantId])
  @@index([dormitoryId, roomId, status])
  @@map("daily_stays")
}

model DailyStayInvoice {
  id                    String    @id @default(uuid()) @db.Uuid
  dormitoryId           String    @map("dormitory_id") @db.Uuid
  dailyStayId           String    @unique @map("daily_stay_id") @db.Uuid
  invoiceNumber         String    @map("invoice_number") @db.VarChar(100)
  totalRentAmount       Decimal   @default(0.00) @map("total_rent_amount") @db.Decimal(12, 2)
  depositAmount         Decimal   @default(0.00) @map("deposit_amount") @db.Decimal(12, 2)
  totalAgreedAmount     Decimal   @default(0.00) @map("total_agreed_amount") @db.Decimal(12, 2)
  outstandingAmount     Decimal   @default(0.00) @map("outstanding_amount") @db.Decimal(12, 2)
  depositDeclaredStatus String    @default("UNPAID") @map("deposit_declared_status") @db.VarChar(50) // PAID | UNPAID
  status                String    @default("ISSUED") @db.VarChar(50) // ISSUED | CANCELLED | SETTLED
  issuedAt              DateTime  @default(now()) @map("issued_at") @db.Timestamptz()
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz()

  dormitory Dormitory              @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  dailyStay DailyStay              @relation(fields: [dailyStayId], references: [id], onDelete: Cascade)
  items     DailyStayInvoiceItem[]

  @@unique([dormitoryId, invoiceNumber], name: "dormitory_daily_invoice_number_unique")
  @@index([dormitoryId])
  @@index([dailyStayId])
  @@map("daily_stay_invoices")
}

model DailyStayInvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  itemType    String   @map("item_type") @db.VarChar(50) // DAILY_RENT | DEPOSIT
  description String   @db.VarChar(255)
  amount      Decimal  @default(0.00) @map("amount") @db.Decimal(12, 2)
  status      String    @default("OUTSTANDING") @db.VarChar(50) // OUTSTANDING | DECLARED_PAID | SETTLED
  paidAt      DateTime? @map("paid_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  invoice DailyStayInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("daily_stay_invoice_items")
}
