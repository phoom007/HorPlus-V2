// Prisma Schema for HorPlus-Version 2 (Foundation, Identity & Dormitory Provisioning)
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// Foundation metadata table for initial migration baseline
model MigrationMeta {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz()

  @@map("migration_meta")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  googleSubject   String    @unique @map("google_subject") @db.VarChar(255)
  email           String    @db.VarChar(255)
  emailNormalized String    @unique @map("email_normalized") @db.VarChar(255)
  name            String    @db.VarChar(255)
  avatarUrl       String?   @map("avatar_url") @db.Text
  phone           String?   @db.VarChar(50)
  status          String    @default("active") @db.VarChar(50) // active, suspended, deleted
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz()

  memberships                DormitoryMember[]
  sessions                   Session[]
  paymentUploadIntents       PaymentUploadIntent[]
  subscriptionHistories      SubscriptionStatusHistory[]
  promoRedemptions           PromoRedemption[]
  ownerSignatures            OwnerSignature[]
  accountBenefitClaims       AccountBenefitClaim[]
  subscriptionPackageIntents SubscriptionPackageIntent[]
  referralCode               UserReferralCode?
  inviteeAttribution         ReferralAttribution?        @relation("InviteeAttribution")
  inviterAttributions        ReferralAttribution[]       @relation("InviterAttributions")
  coinWallet                 CoinWallet?
  coinLedgerEntries          CoinLedgerEntry[]

  @@map("users")
}

model Dormitory {
  id                     String    @id @default(uuid()) @db.Uuid
  name                   String    @db.VarChar(255)
  code                   String?   @db.VarChar(100)
  type                   String    @default("apartment") @db.VarChar(100)
  addressLine1           String?   @map("address_line1") @db.VarChar(255)
  addressLine2           String?   @map("address_line2") @db.VarChar(255)
  subdistrict            String?   @db.VarChar(100)
  district               String?   @db.VarChar(100)
  province               String?   @db.VarChar(100)
  genderPolicy           String?   @map("gender_policy") @db.VarChar(50)
  postalCode             String?   @map("postal_code") @db.VarChar(20)
  countryCode            String    @default("TH") @map("country_code") @db.VarChar(10)
  phone                  String?   @db.VarChar(50)
  email                  String?   @db.VarChar(255)
  estimatedBuildingCount Int       @default(1) @map("estimated_building_count")
  estimatedRoomCount     Int       @default(10) @map("estimated_room_count")
  timezone               String    @default("Asia/Bangkok") @db.VarChar(50)
  currency               String    @default("THB") @db.VarChar(10)
  status                 String    @default("setup_pending") @db.VarChar(50) // setup_pending, active, suspended
  createdByUserId        String?   @map("created_by_user_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz()

  members                    DormitoryMember[]
  roles                      Role[]
  billingSettings            DormitoryBillingSettings?
  subscriptions              PlatformSubscription[]
  buildings                  Building[]
  rooms                      Room[]
  tenants                    Tenant[]
  contracts                  Contract[]
  coOccupants                TenantCoOccupant[]
  emergencyContacts          TenantEmergencyContact[]
  vehicles                   TenantVehicle[]
  billingCycles              BillingCycle[]
  rateSnapshots              BillingRateSnapshot[]
  meterDevices               MeterDevice[]
  meterReadings              MeterReading[]
  meterReplacements          MeterReplacement[]
  bills                      Bill[]
  billItems                  BillItem[]
  tenantRegistrationRequests TenantRegistrationRequest[]
  occupancies                Occupancy[]
  moveOutRequests            TenantMoveOutRequest[]
  Payment                    Payment[]
  Receipt                    Receipt[]
  ReceiptSequence            ReceiptSequence[]
  paymentUploadIntents       PaymentUploadIntent[]
  dormitorySubscription      DormitorySubscription?
  subscriptionHistories      SubscriptionStatusHistory[]
  promoRedemptions           PromoRedemption[]
  propertyDefaults           DormitoryPropertyDefaults?
  contractSnapshots          ContractSnapshot[]
  auditLogs                  AuditLog[]
  lineFriends                DormitoryLineFriend[]
  accessGrants               DormitoryAccessGrant[]
  lineConfig                 DormitoryLineConfig?
  lineWebhookReceipts        LineWebhookEventReceipt[]
  linePushUsage              LinePushUsage[]
  linePushDeliveryAttempts   LinePushDeliveryAttempt[]
  referralAttributions       ReferralAttribution[]
  onboardingDrafts           OnboardingDraft[]
  ownerSignatures            OwnerSignature[]
  accountBenefitClaims       AccountBenefitClaim[]
  subscriptionPackageIntents SubscriptionPackageIntent[]
  renewalRequests            TenantRenewalRequest[]
  settlements                ContractSettlement[]
  notices                    TenantNotice[]
  outboxEvents               LocalNotificationOutbox[]
  staffNotices               StaffNotification[]
  roomBillingCycleSnapshots  RoomBillingCycleSnapshot[]
  roomNextCycleCorrections   RoomNextCycleCorrection[]
  provisionalRentalTerms     ProvisionalRentalTerm[]
  dailyStays                 DailyStay[]
  dailyStayInvoices          DailyStayInvoice[]
  combinedPaymentGroups      CombinedPaymentGroup[]

  @@map("dormitories")
}

model DormitoryBillingSettings {
  id                         String   @id @default(uuid()) @db.Uuid
  dormitoryId                String   @unique @map("dormitory_id") @db.Uuid
  billingDay                 Int      @default(25) @map("billing_day")
  dueDay                     Int      @map("due_day")
  waterBillingType           String   @default("per_person") @map("water_billing_type") @db.VarChar(50)
  waterRate                  Decimal  @default(0.00) @map("water_rate") @db.Decimal(12, 2)
  electricityBillingType     String   @default("per_unit") @map("electricity_billing_type") @db.VarChar(50)
  electricityRate            Decimal  @default(0.00) @map("electricity_rate") @db.Decimal(12, 2)
  commonFee                  Decimal  @default(0.00) @map("common_fee") @db.Decimal(12, 2)
  commonFeeMode              String   @default("per_room") @map("common_fee_mode") @db.VarChar(50)
  internetFee                Decimal  @default(0.00) @map("internet_fee") @db.Decimal(12, 2)
  internetFeeMode            String   @default("per_person") @map("internet_fee_mode") @db.VarChar(50)
  parkingRate                Decimal  @default(0.00) @map("parking_rate") @db.Decimal(12, 2)
  parkingFeeMode             String   @default("per_room") @map("parking_fee_mode") @db.VarChar(50)
  gracePeriodDays            Int      @default(0) @map("grace_period_days")
  advanceRentMonths          Int      @default(1) @map("advance_rent_months")
  lateFeeType                String   @default("none") @map("late_fee_type") @db.VarChar(50)
  lateFeeValue               Decimal  @default(0.00) @map("late_fee_value") @db.Decimal(12, 2)
  rentBillingType            String   @default("monthly") @map("rent_billing_type") @db.VarChar(50)
  cashAccepted               Boolean  @default(true) @map("cash_accepted")
  promptPayType              String?  @map("prompt_pay_type") @db.VarChar(50)
  promptPayValue             String?  @map("prompt_pay_value") @db.VarChar(255)
  promptPayValueEncrypted    String?  @map("prompt_pay_value_encrypted") @db.Text
  promptPayAccountName       String?  @map("prompt_pay_account_name") @db.VarChar(255)
  bankCode                   String?  @map("bank_code") @db.VarChar(50)
  bankAccountName            String?  @map("bank_account_name") @db.VarChar(255)
  bankAccountNumber          String?  @map("bank_account_number") @db.VarChar(100)
  bankAccountNumberEncrypted String?  @map("bank_account_number_encrypted") @db.Text
  version                    Int      @default(1)
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  dormitory Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)

  @@map("dormitory_billing_settings")
}

model DormitoryPropertyDefaults {
  id                    String   @id @default(uuid()) @db.Uuid
  dormitoryId           String   @unique @map("dormitory_id") @db.Uuid
  defaultMonthlyRent    Decimal  @default(0.00) @map("default_monthly_rent") @db.Decimal(12, 2)
  defaultTermRent       Decimal? @map("default_term_rent") @db.Decimal(12, 2)
  defaultDailyRent      Decimal? @map("default_daily_rent") @db.Decimal(12, 2)
  defaultDeposit        Decimal  @default(0.00) @map("default_deposit") @db.Decimal(12, 2)
  defaultAdvancePayment Decimal  @default(0.00) @map("default_advance_payment") @db.Decimal(12, 2)
  defaultParkingFee     Decimal  @default(0.00) @map("default_parking_fee") @db.Decimal(12, 2)
  defaultMaxOccupants   Int      @default(2) @map("default_max_occupants")
  defaultRoomType       String   @default("standard") @map("default_room_type") @db.VarChar(100)
  defaultTerms          String?  @map("default_terms") @db.Text
  petPolicy             Json     @default("{\"allowed\":\"none\",\"allowedTypes\":[]}") @map("pet_policy")
  version               Int      @default(1)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  dormitory Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)

  @@map("dormitory_property_defaults")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  dormitoryId String?  @map("dormitory_id") @db.Uuid
  code        String   @db.VarChar(50) // OWNER, MANAGER, STAFF
  name        String   @db.VarChar(100)
  permissions Json     @map("permissions")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  dormitory Dormitory?        @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  members   DormitoryMember[]

  @@unique([dormitoryId, code], name: "dormitory_role_code_unique")
  @@map("roles")
}

model DormitoryMember {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  dormitoryId      String    @map("dormitory_id") @db.Uuid
  roleId           String    @map("role_id") @db.Uuid
  status           String    @default("active") @db.VarChar(50) // invited, active, suspended, revoked
  membershipOrigin String    @default("LEGACY_MEMBER") @map("membership_origin") @db.VarChar(50) // GOOGLE_BOOTSTRAP, LEGACY_MEMBER, MANUAL_GRANT
  invitedAt        DateTime? @map("invited_at") @db.Timestamptz()
  acceptedAt       DateTime? @map("accepted_at") @db.Timestamptz()
  suspendedAt      DateTime? @map("suspended_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dormitory Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, dormitoryId], name: "user_dormitory_unique")
  @@map("dormitory_members")
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String?   @map("user_id") @db.Uuid
  principalType String    @default("GOOGLE_USER") @map("principal_type") @db.VarChar(50) // GOOGLE_USER, ACCESS_GRANT
  accessGrantId String?   @map("access_grant_id") @db.Uuid
  sessionIdHash String    @unique @map("session_id_hash") @db.VarChar(255)
  tokenVersion  Int       @default(1) @map("token_version")
  status        String    @default("active") @db.VarChar(50) // active, revoked, expired
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz()
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz()
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz()
  revokedReason String?   @map("revoked_reason") @db.VarChar(255)
  userAgentHash String?   @map("user_agent_hash") @db.VarChar(255)
  ipMetadata    String?   @map("ip_metadata") @db.VarChar(255)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  user        User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessGrant DormitoryAccessGrant? @relation(fields: [accessGrantId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model PlatformPlan {
  id                  String   @id @default(uuid()) @db.Uuid
  code                String   @unique @db.VarChar(50)
  name                String   @db.VarChar(100)
  monthlyPrice        Decimal  @map("monthly_price") @db.Decimal(12, 2)
  currency            String   @default("THB") @db.VarChar(10)
  vatIncluded         Boolean  @default(true) @map("vat_included")
  roomLimit           Int?     @map("room_limit")
  messageQuotaMonthly Int      @default(300) @map("message_quota_monthly")
  isActive            Boolean  @default(true) @map("is_active")
  displayOrder        Int      @default(0) @map("display_order")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  subscriptions PlatformSubscription[]

  @@map("platform_plans")
}

model PlatformSubscription {
  id                     String    @id @default(uuid()) @db.Uuid
  dormitoryId            String    @map("dormitory_id") @db.Uuid
  planId                 String    @map("plan_id") @db.Uuid
  status                 String    @default("trialing") @db.VarChar(50) // trialing, active, past_due, suspended, cancelled, expired
  billingInterval        String    @default("monthly") @map("billing_interval") @db.VarChar(50)
  trialStartedAt         DateTime? @map("trial_started_at") @db.Timestamptz()
  trialEndsAt            DateTime? @map("trial_ends_at") @db.Timestamptz()
  currentPeriodStartedAt DateTime? @map("current_period_started_at") @db.Timestamptz()
  currentPeriodEndsAt    DateTime? @map("current_period_ends_at") @db.Timestamptz()
  cancelAtPeriodEnd      Boolean   @default(false) @map("cancel_at_period_end")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  dormitory Dormitory    @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  plan      PlatformPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("platform_subscriptions")
}

model PlatformPromoCode {
  id              String    @id @default(uuid()) @db.Uuid
  code            String    @unique @db.VarChar(50)
  codeNormalized  String    @unique @map("code_normalized") @db.VarChar(50)
  status          String    @default("active") @db.VarChar(50)
  trialBonusDays  Int       @default(0) @map("trial_bonus_days")
  validFrom       DateTime? @map("valid_from") @db.Timestamptz()
  validUntil      DateTime? @map("valid_until") @db.Timestamptz()
  maxRedemptions  Int?      @map("max_redemptions")
  redemptionCount Int       @default(0) @map("redemption_count")
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  redemptions PlatformPromoRedemption[]

  @@map("platform_promo_codes")
}

model PlatformPromoRedemption {
  id             String   @id @default(uuid()) @db.Uuid
  promoCodeId    String   @map("promo_code_id") @db.Uuid
  dormitoryId    String   @map("dormitory_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  bonusDays      Int      @map("bonus_days")
  redeemedAt     DateTime @default(now()) @map("redeemed_at") @db.Timestamptz()
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  promoCode PlatformPromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, dormitoryId], name: "promo_dormitory_unique")
  @@map("platform_promo_redemptions")
}

model OnboardingDraft {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @unique @map("user_id") @db.Uuid
  provisionalDormitoryId String?   @map("provisional_dormitory_id") @db.Uuid
  version                Int       @default(1)
  currentStep            String    @default("dormitory") @map("current_step") @db.VarChar(50)
  payload                Json
  expiresAt              DateTime  @map("expires_at") @db.Timestamptz()
  finalizedAt            DateTime? @map("finalized_at") @db.Timestamptz()
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  provisionalDormitory Dormitory? @relation(fields: [provisionalDormitoryId], references: [id], onDelete: SetNull)

  @@map("onboarding_drafts")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  operation      String   @db.VarChar(100)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(255)
  requestHash    String   @map("request_hash") @db.VarChar(255)
  status         String   @default("processing") @db.VarChar(50) // processing, completed, failed
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  resourceType   String?  @map("resource_type") @db.VarChar(100)
  resourceId     String?  @map("resource_id") @db.VarChar(255)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz()
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([userId, operation, idempotencyKey], name: "user_operation_idempotency_unique")
  @@map("idempotency_keys")
}

model Building {
  id                      String    @id @default(uuid()) @db.Uuid
  dormitoryId             String    @map("dormitory_id") @db.Uuid
  name                    String    @db.VarChar(255)
  code                    String?   @db.VarChar(100)
  floorCount              Int       @default(1) @map("floor_count")
  roomsPerFloor           Int?      @map("rooms_per_floor")
  roomPrefix              String?   @map("room_prefix") @db.VarChar(50)
  hasElevator             Boolean   @default(false) @map("has_elevator")
  numberingPattern        String?   @map("numbering_pattern") @db.VarChar(100)
  description             String?   @db.Text
  status                  String    @default("active") @db.VarChar(50)
  displayOrder            Int       @default(0) @map("display_order")
  monthlyRent             Decimal?  @map("monthly_rent") @db.Decimal(12, 2)
  termRent                Decimal?  @map("term_rent") @db.Decimal(12, 2)
  termMonths              Int?      @default(6) @map("term_months")
  maxTermRentInstallments Int       @default(1) @map("max_term_rent_installments")
  dailyRent               Decimal?  @map("daily_rent") @db.Decimal(12, 2)
  depositAmount           Decimal?  @map("deposit_amount") @db.Decimal(12, 2)
  advancePaymentAmount    Decimal?  @map("advance_payment_amount") @db.Decimal(12, 2)
  waterRate               Decimal?  @map("water_rate") @db.Decimal(12, 2)
  electricityRate         Decimal?  @map("electricity_rate") @db.Decimal(12, 2)
  commonFee               Decimal?  @map("common_fee") @db.Decimal(12, 2)
  internetFee             Decimal?  @map("internet_fee") @db.Decimal(12, 2)
  parkingFee              Decimal?  @map("parking_fee") @db.Decimal(12, 2)
  waterBillingType        String?   @map("water_billing_type") @db.VarChar(50)
  electricityBillingType  String?   @map("electricity_billing_type") @db.VarChar(50)
  rentBillingType         String?   @map("rent_billing_type") @db.VarChar(50)
  maximumOccupants        Int?      @map("maximum_occupants")
  roomType                String?   @map("room_type") @db.VarChar(100)
  version                 Int       @default(1)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt               DateTime? @map("deleted_at") @db.Timestamptz()

  dormitory Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  rooms     Room[]

  @@unique([dormitoryId, code], name: "dormitory_building_code_unique")
  @@unique([dormitoryId, name], name: "dormitory_building_name_unique")
  @@map("buildings")
}

model Room {
  id                             String    @id @default(uuid()) @db.Uuid
  dormitoryId                    String    @map("dormitory_id") @db.Uuid
  buildingId                     String    @map("building_id") @db.Uuid
  building                       Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  roomNumber                     String    @map("room_number") @db.VarChar(100)
  normalizedRoomNumber           String    @map("normalized_room_number") @db.VarChar(100)
  /// @deprecated Do not use. Floor grouping is now derived dynamically from Building.numberingPattern and Room.roomNumber.
  floor                          Int       @default(1)
  roomType                       String?   @map("room_type") @db.VarChar(100)
  status                         String    @default("vacant") @db.VarChar(50)
  rentCycle                      String    @default("monthly") @map("rent_cycle") @db.VarChar(50)
  monthlyRent                    Decimal?  @map("monthly_rent") @db.Decimal(12, 2)
  termRent                       Decimal?  @map("term_rent") @db.Decimal(12, 2)
  termMonths                     Int?      @default(6) @map("term_months")
  dailyRent                      Decimal?  @map("daily_rent") @db.Decimal(12, 2)
  depositAmount                  Decimal?  @map("deposit_amount") @db.Decimal(12, 2)
  depositInheritsBuildingDefault Boolean   @default(true) @map("deposit_inherits_building_default")
  advancePaymentAmount           Decimal?  @map("advance_payment_amount") @db.Decimal(12, 2)
  waterRate                      Decimal?  @map("water_rate") @db.Decimal(12, 2)
  electricityRate                Decimal?  @map("electricity_rate") @db.Decimal(12, 2)
  commonFee                      Decimal?  @map("common_fee") @db.Decimal(12, 2)
  internetFee                    Decimal?  @map("internet_fee") @db.Decimal(12, 2)
  parkingFee                     Decimal?  @map("parking_fee") @db.Decimal(12, 2)
  waterBillingType               String?   @map("water_billing_type") @db.VarChar(50)
  electricityBillingType         String?   @map("electricity_billing_type") @db.VarChar(50)
  rentBillingType                String?   @map("rent_billing_type") @db.VarChar(50)
  maximumOccupants               Int?      @map("maximum_occupants")
  waterMeterNumber               String?   @map("water_meter_number") @db.VarChar(100)
  electricityMeterNumber         String?   @map("electricity_meter_number") @db.VarChar(100)
  initialWaterReading            Decimal   @default(0.00) @map("initial_water_reading") @db.Decimal(12, 2)
  initialElectricityReading      Decimal   @default(0.00) @map("initial_electricity_reading") @db.Decimal(12, 2)
  amenities                      Json?     @map("amenities")
  images                         Json?     @map("images")
  notes                          String?   @db.Text
  currentTenantId                String?   @map("current_tenant_id") @db.Uuid
  currentContractId              String?   @map("current_contract_id") @db.Uuid
  version                        Int       @default(1)
