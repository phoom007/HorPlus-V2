  tenantId                String    @map("tenant_id") @db.Uuid
  roomId                  String    @map("room_id") @db.Uuid
  submittedLineIdentityId String?   @map("submitted_line_identity_id") @db.Uuid
  intendedMoveOutDate     DateTime  @map("intended_move_out_date") @db.Date
  refundBankName          String?   @map("refund_bank_name") @db.VarChar(100)
  refundAccountNumber     String?   @map("refund_account_number") @db.VarChar(100)
  refundAccountName       String?   @map("refund_account_name") @db.VarChar(255)
  reason                  String?   @db.Text
  status                  String    @default("SCHEDULED") @db.VarChar(50) // SCHEDULED, COMPLETED, CANCELLED
  submittedAt             DateTime  @default(now()) @map("submitted_at") @db.Timestamptz()
  completedAt             DateTime? @map("completed_at") @db.Timestamptz()
  completedByUserId       String?   @map("completed_by_user_id") @db.Uuid
  actualEndedAt           DateTime? @map("actual_ended_at") @db.Date
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  version                 Int       @default(1)

  dormitory Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  occupancy Occupancy @relation(fields: [occupancyId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("tenant_move_out_requests")
}

model Payment {
  id               String    @id @default(uuid()) @db.Uuid
  dormitoryId      String    @map("dormitory_id") @db.Uuid
  billId           String    @map("bill_id") @db.Uuid
  tenantId         String?   @map("tenant_id") @db.Uuid
  method           String    @db.VarChar(50)
  amount           Decimal   @db.Decimal(12, 2)
  status           String    @default("PENDING") @db.VarChar(50)
  paymentDate      DateTime  @map("payment_date") @db.Timestamptz()
  evidenceUrl      String?   @map("evidence_url") @db.Text
  fileHash         String?   @unique @map("file_hash") @db.VarChar(255)
  reviewedByUserId String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz()
  rejectedReason   String?   @map("rejected_reason") @db.Text
  reversedByUserId String?   @map("reversed_by_user_id") @db.Uuid
  reversedAt       DateTime? @map("reversed_at") @db.Timestamptz()
  reversalReason   String?   @map("reversal_reason") @db.Text
  metadata         Json?
  idempotencyKey   String?   @map("idempotency_key") @db.VarChar(100)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  dormitory       Dormitory              @relation(fields: [dormitoryId], references: [id], onDelete: Restrict)
  bill            Bill                   @relation(fields: [billId], references: [id], onDelete: Restrict)
  tenant          Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  statusHistories PaymentStatusHistory[]
  receipt         Receipt?

  @@unique([idempotencyKey], name: "payment_idempotency_key_unique")
  @@map("payments")
}

model PaymentStatusHistory {
  id              String   @id @default(uuid()) @db.Uuid
  dormitoryId     String   @map("dormitory_id") @db.Uuid
  paymentId       String   @map("payment_id") @db.Uuid
  fromStatus      String?  @map("from_status") @db.VarChar(50)
  toStatus        String   @map("to_status") @db.VarChar(50)
  reason          String?  @db.Text
  changedByUserId String?  @map("changed_by_user_id") @db.Uuid
  effectiveAt     DateTime @default(now()) @map("effective_at") @db.Timestamptz()
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@map("payment_status_histories")
}

model Receipt {
  id             String    @id @default(uuid()) @db.Uuid
  dormitoryId    String    @map("dormitory_id") @db.Uuid
  paymentId      String    @unique @map("payment_id") @db.Uuid
  billId         String    @map("bill_id") @db.Uuid
  receiptNumber  String    @map("receipt_number") @db.VarChar(100)
  snapshotData   Json      @map("snapshot_data")
  isVoided       Boolean   @default(false) @map("is_voided")
  voidedAt       DateTime? @map("voided_at") @db.Timestamptz()
  voidedByUserId String?   @map("voided_by_user_id") @db.Uuid
  voidReason     String?   @map("void_reason") @db.Text
  issuedAt       DateTime  @default(now()) @map("issued_at") @db.Timestamptz()
  issuedByUserId String?   @map("issued_by_user_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  dormitory Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Restrict)
  payment   Payment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  bill      Bill      @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@unique([dormitoryId, receiptNumber], name: "dormitory_receipt_number_unique")
  @@map("receipts")
}

model ReceiptSequence {
  id          String   @id @default(uuid()) @db.Uuid
  dormitoryId String   @map("dormitory_id") @db.Uuid
  yearMonth   String   @map("year_month") @db.VarChar(6)
  lastValue   Int      @default(0) @map("last_value")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  dormitory Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Restrict)

  @@unique([dormitoryId, yearMonth], name: "dormitory_receipt_seq_unique")
  @@map("receipt_sequences")
}


model PaymentUploadIntent {
  id                  String    @id @default(uuid()) @db.Uuid
  authenticatedUserId String    @map("authenticated_user_id") @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  dormitoryId         String    @map("dormitory_id") @db.Uuid
  billId              String    @map("bill_id") @db.Uuid
  status              String    @default("CREATED") @db.VarChar(50)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz()
  expectedMimeType    String?   @map("expected_mime_type") @db.VarChar(100)
  expectedSize        Int?      @map("expected_size")
  verifiedMimeType    String?   @map("verified_mime_type") @db.VarChar(100)
  verifiedSize        Int?      @map("verified_size")
  objectKey           String?   @map("object_key") @db.Text
  sha256              String?   @map("sha256") @db.VarChar(255)
  uploadedAt          DateTime? @map("uploaded_at") @db.Timestamptz()
  consumedAt          DateTime? @map("consumed_at") @db.Timestamptz()
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  authenticatedUser User      @relation(fields: [authenticatedUserId], references: [id], onDelete: Restrict)
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  dormitory         Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Restrict)
  bill              Bill      @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@index([authenticatedUserId], name: "idx_intent_actor")
  @@index([tenantId], name: "idx_intent_tenant")
  @@index([dormitoryId], name: "idx_intent_dormitory")
  @@index([billId], name: "idx_intent_bill")
  @@index([status, expiresAt], name: "idx_intent_status_expires")
  @@map("payment_upload_intents")
}

// ----------------------------------------------------------------------
// Wave 1F Subscription & Entitlement Models
// ----------------------------------------------------------------------

enum SubscriptionPlanType {
  FREE
  PAID
}

enum DormitorySubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

model SubscriptionPlan {
  id        String               @id @default(uuid()) @db.Uuid
  code      String               @unique @db.VarChar(50)
  name      String               @db.VarChar(100)
  type      SubscriptionPlanType @default(FREE)
  roomLimit Int                  @map("room_limit")
  messageQuotaMonthly Int @default(30) @map("message_quota_monthly")
  enabled   Boolean              @default(true)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz()

  packages               SubscriptionPackage[]
  dormitorySubscriptions DormitorySubscription[]
  previousPlanHistories  SubscriptionStatusHistory[] @relation("PreviousPlanHistory")
  newPlanHistories       SubscriptionStatusHistory[] @relation("NewPlanHistory")

  @@map("subscription_plans")
}

model SubscriptionPackage {
  id             String   @id @default(uuid()) @db.Uuid
  planId         String   @map("plan_id") @db.Uuid
  durationMonths Int      @map("duration_months")
  price          Decimal? @db.Decimal(12, 2)
  currency       String   @default("THB") @db.VarChar(10)
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([planId, durationMonths], name: "plan_duration_unique")
  @@map("subscription_packages")
}

model DormitorySubscription {
  id              String                      @id @default(uuid()) @db.Uuid
  dormitoryId     String                      @unique @map("dormitory_id") @db.Uuid
  planId          String                      @map("plan_id") @db.Uuid
  status          DormitorySubscriptionStatus @default(TRIAL)
  startedAt       DateTime                    @default(now()) @map("started_at") @db.Timestamptz()
  expiresAt       DateTime                    @map("expires_at") @db.Timestamptz()
  trialStartedAt  DateTime?                   @map("trial_started_at") @db.Timestamptz()
  trialExpiresAt  DateTime?                   @map("trial_expires_at") @db.Timestamptz()
  promoExtendedAt DateTime?                   @map("promo_extended_at") @db.Timestamptz()
  cancelledAt     DateTime?                   @map("cancelled_at") @db.Timestamptz()
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime                    @updatedAt @map("updated_at") @db.Timestamptz()

  dormitory        Dormitory                  @relation(fields: [dormitoryId], references: [id], onDelete: Restrict)
  plan             SubscriptionPlan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  statusHistories  SubscriptionStatusHistory[]
  promoRedemptions PromoRedemption[]

  @@index([dormitoryId])
  @@index([expiresAt])
  @@index([status])
  @@map("dormitory_subscriptions")
}

model SubscriptionStatusHistory {
  id             String                       @id @default(uuid()) @db.Uuid
  subscriptionId String                       @map("subscription_id") @db.Uuid
  dormitoryId    String                       @map("dormitory_id") @db.Uuid
  previousStatus DormitorySubscriptionStatus? @map("previous_status")
  newStatus      DormitorySubscriptionStatus  @map("new_status")
  previousPlanId String?                      @map("previous_plan_id") @db.Uuid
  newPlanId      String                       @map("new_plan_id") @db.Uuid
  effectiveAt    DateTime                     @default(now()) @map("effective_at") @db.Timestamptz()
  actorId        String?                      @map("actor_id") @db.Uuid
  reason         String                       @db.VarChar(255)
  metadata       Json?
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz()

  subscription DormitorySubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  dormitory    Dormitory             @relation(fields: [dormitoryId], references: [id], onDelete: Restrict)
  previousPlan SubscriptionPlan?     @relation("PreviousPlanHistory", fields: [previousPlanId], references: [id], onDelete: Restrict)
  newPlan      SubscriptionPlan      @relation("NewPlanHistory", fields: [newPlanId], references: [id], onDelete: Restrict)
  actor        User?                 @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([subscriptionId])
  @@index([dormitoryId])
  @@index([actorId])
  @@map("subscription_status_histories")
}

model PromoCode {
  id                             String    @id @default(uuid()) @db.Uuid
  code                           String    @unique @db.VarChar(50)
  normalizedCode                 String    @unique @map("normalized_code") @db.VarChar(50)
  extensionDays                  Int       @default(60) @map("extension_days")
  enabled                        Boolean   @default(true)
  startsAt                       DateTime? @map("starts_at") @db.Timestamptz()
  endsAt                         DateTime? @map("ends_at") @db.Timestamptz()
  maximumRedemptionsPerDormitory Int       @default(1) @map("maximum_redemptions_per_dormitory")
  createdAt                      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  redemptions PromoRedemption[]

  @@map("promo_codes")
}

model PromoRedemption {
  id                String   @id @default(uuid()) @db.Uuid
  promoCodeId       String   @map("promo_code_id") @db.Uuid
  dormitoryId       String   @map("dormitory_id") @db.Uuid
  subscriptionId    String   @map("subscription_id") @db.Uuid
  redeemedBy        String   @map("redeemed_by") @db.Uuid
  previousExpiresAt DateTime @map("previous_expires_at") @db.Timestamptz()
  newExpiresAt      DateTime @map("new_expires_at") @db.Timestamptz()
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()

  promoCode    PromoCode             @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  subscription DormitorySubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  dormitory    Dormitory             @relation(fields: [dormitoryId], references: [id], onDelete: Restrict)
  redeemer     User                  @relation(fields: [redeemedBy], references: [id], onDelete: Restrict)

  @@unique([promoCodeId, dormitoryId], name: "promo_dormitory_unique")
  @@index([dormitoryId])
  @@index([subscriptionId])
  @@index([redeemedBy])
  @@map("promo_redemptions")
}

model DormitoryLineFriend {
  id                  String    @id @default(uuid()) @db.Uuid
  dormitoryId         String    @map("dormitory_id") @db.Uuid
  lineUserIdHash      String    @map("line_user_id_hash") @db.VarChar(255)
  lineUserIdEncrypted String    @map("line_user_id_encrypted") @db.Text
  displayName         String    @map("display_name") @db.VarChar(255)
  pictureUrl          String?   @map("picture_url") @db.Text
  friendStatus        String    @default("FOLLOWING") @db.VarChar(50) // FOLLOWING, UNFOLLOWED
  followedAt          DateTime  @default(now()) @map("followed_at") @db.Timestamptz()
  unfollowedAt        DateTime? @map("unfollowed_at") @db.Timestamptz()
  lastSeenAt          DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz()
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  dormitory    Dormitory              @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  accessGrants DormitoryAccessGrant[]

  @@unique([dormitoryId, lineUserIdHash], name: "dormitory_line_friend_unique")
  @@map("dormitory_line_friends")
}

model DormitoryAccessGrant {
  id                 String    @id @default(uuid()) @db.Uuid
  dormitoryId        String    @map("dormitory_id") @db.Uuid
  lineFriendId       String    @map("line_friend_id") @db.Uuid
  tokenHash          String    @unique @map("token_hash") @db.VarChar(255)
  tokenEncrypted     String?   @map("token_encrypted") @db.Text
  tokenPrefix        String?   @map("token_prefix") @db.VarChar(20)
  roleCode           String    @map("role_code") @db.VarChar(20)
  version            Int       @default(1)
  status             String    @default("ACTIVE") @db.VarChar(20)
  createdByPrincipal String    @map("created_by_principal") @db.VarChar(255)
  revokedByPrincipal String?   @map("revoked_by_principal") @db.VarChar(255)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz()
  lastRoleChangedAt  DateTime? @map("last_role_changed_at") @db.Timestamptz()
  lastDeliveryStatus    String?   @map("last_delivery_status") @db.VarChar(50)
  lastDeliveryAttemptAt DateTime? @map("last_delivery_attempt_at") @db.Timestamptz()
  lastDeliverySuccessAt DateTime? @map("last_delivery_success_at") @db.Timestamptz()
  lastDeliveryErrorCode String?   @map("last_delivery_error_code") @db.VarChar(100)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  dormitory  Dormitory           @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  lineFriend DormitoryLineFriend @relation(fields: [lineFriendId], references: [id], onDelete: Cascade)
  sessions   Session[]
  deliveryAttempts LinePushDeliveryAttempt[]

  @@index([dormitoryId, status])
  @@map("dormitory_access_grants")
}

model DormitoryLineConfig {
  id                          String    @id @default(uuid()) @db.Uuid
  dormitoryId                 String    @unique @map("dormitory_id") @db.Uuid
  lineOaId                    String?   @map("line_oa_id") @db.VarChar(100)
  channelId                   String?   @map("channel_id") @db.VarChar(100)
  channelSecretEncrypted      String?   @map("channel_secret_encrypted") @db.Text
  channelAccessTokenEncrypted String?   @map("channel_access_token_encrypted") @db.Text
  encryptionKeyVersion        Int       @default(1) @map("encryption_key_version")
  webhookKeyHash              String    @unique @map("webhook_key_hash") @db.VarChar(255)
  webhookKeyEncrypted         String?   @map("webhook_key_encrypted") @db.Text
  isConnected                 Boolean   @default(false) @map("is_connected")
  lastVerifiedAt              DateTime? @map("last_verified_at") @db.Timestamptz()
  accessTokenVerifiedAt DateTime? @map("access_token_verified_at") @db.Timestamptz()
  webhookVerifiedAt     DateTime? @map("webhook_verified_at") @db.Timestamptz()
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  dormitory Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)

  @@map("dormitory_line_configs")
}

model LineWebhookEventReceipt {
  id             String    @id @default(uuid()) @db.Uuid
  dormitoryId    String    @map("dormitory_id") @db.Uuid
  webhookEventId String    @unique @map("webhook_event_id") @db.VarChar(255)
  eventType      String    @map("event_type") @db.VarChar(100)
  status         String    @db.VarChar(50) // processed, ignored, failed
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz()
  processedAt    DateTime? @map("processed_at") @db.Timestamptz()

  dormitory Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)

  @@map("line_webhook_event_receipts")
}

model LinePushUsage {
  id            String   @id @default(uuid()) @db.Uuid
  dormitoryId   String   @map("dormitory_id") @db.Uuid
  periodKey     String   @map("period_key") @db.VarChar(30)
  successCount  Int      @default(0) @map("success_count")
  reservedCount Int      @default(0) @map("reserved_count")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  dormitory Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)

  @@unique([dormitoryId, periodKey], name: "dormitory_push_period_unique", map: "dormitory_push_period_unique")
  @@map("line_push_usage")
}

model LinePushDeliveryAttempt {
  id                String    @id @default(uuid()) @db.Uuid
  dormitoryId       String    @map("dormitory_id") @db.Uuid
  accessGrantId     String    @map("access_grant_id") @db.Uuid
  periodKey         String    @map("period_key") @db.VarChar(30)
  lineRetryKey      String    @map("line_retry_key") @db.VarChar(36)
  status            String    @default("RESERVED") @db.VarChar(50)
  lineMessageId     String?   @map("line_message_id") @db.VarChar(255)
  errorCode         String?   @map("error_code") @db.VarChar(100)
  attemptedAt       DateTime? @map("attempted_at") @db.Timestamptz()
  finalizedAt       DateTime? @map("finalized_at") @db.Timestamptz()
  retryKeyCreatedAt DateTime  @default(now()) @map("retry_key_created_at") @db.Timestamptz()
  retryKeyExpiresAt DateTime? @map("retry_key_expires_at") @db.Timestamptz()
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  dormitory   Dormitory            @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  accessGrant DormitoryAccessGrant @relation(fields: [accessGrantId], references: [id], onDelete: Cascade)

  @@index([accessGrantId])
  @@map("line_push_delivery_attempts")
}
