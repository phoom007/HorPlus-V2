// Prisma Schema for HorPlus-Version 2 (Foundation, Identity & Dormitory Provisioning)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Foundation metadata table for initial migration baseline
model MigrationMeta {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz()

  @@map("migration_meta")
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  googleSubject   String   @unique @map("google_subject") @db.VarChar(255)
  email           String   @db.VarChar(255)
  emailNormalized String   @unique @map("email_normalized") @db.VarChar(255)
  name            String   @db.VarChar(255)
  avatarUrl       String?  @map("avatar_url") @db.Text
  phone           String?  @db.VarChar(50)
  status          String   @default("active") @db.VarChar(50) // active, suspended, deleted
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz()
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz()

  memberships     DormitoryMember[]
  sessions        Session[]

  @@map("users")
}

model Dormitory {
  id                     String    @id @default(uuid()) @db.Uuid
  name                   String    @db.VarChar(255)
  code                   String?   @db.VarChar(100)
  type                   String    @default("apartment") @db.VarChar(100)
  addressLine1           String?   @map("address_line1") @db.VarChar(255)
  addressLine2           String?   @map("address_line2") @db.VarChar(255)
  subdistrict            String?   @db.VarChar(100)
  district               String?   @db.VarChar(100)
  province               String?   @db.VarChar(100)
  postalCode             String?   @map("postal_code") @db.VarChar(20)
  countryCode            String    @default("TH") @map("country_code") @db.VarChar(10)
  phone                  String?   @db.VarChar(50)
  email                  String?   @db.VarChar(255)
  estimatedBuildingCount Int       @default(1) @map("estimated_building_count")
  estimatedRoomCount     Int       @default(10) @map("estimated_room_count")
  timezone               String    @default("Asia/Bangkok") @db.VarChar(50)
  currency               String    @default("THB") @db.VarChar(10)
  status                 String    @default("active") @db.VarChar(50)
  createdByUserId        String?   @map("created_by_user_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz()

  members               DormitoryMember[]
  roles                 Role[]
  billingSettings       DormitoryBillingSettings?
  paymentSettings       DormitoryPaymentSettings?
  subscriptions         PlatformSubscription[]
  buildings             Building[]
  rooms                 Room[]
  tenants               Tenant[]
  contracts             Contract[]
  coOccupants           TenantCoOccupant[]
  emergencyContacts     TenantEmergencyContact[]
  vehicles              TenantVehicle[]
  billingCycles         BillingCycle[]
  rateSnapshots         BillingRateSnapshot[]
  meterDevices          MeterDevice[]
  meterReadings         MeterReading[]
  meterReplacements      MeterReplacement[]
  bills                 Bill[]
  billItems             BillItem[]
  payments              Payment[]
  paymentEvidences      PaymentEvidence[]
  paymentReviews        PaymentReview[]
  receipts              Receipt[]
  receiptItems          ReceiptItem[]
  lineOaIntegrations    LineOaIntegration[]
  lineFollowers         LineFollower[]
  lineRoleAssignments   LineRoleAssignment[]
  tenantRegistrationRequests TenantRegistrationRequest[]
  tenantLineBindings    TenantLineBinding[]

  @@map("dormitories")
}

model DormitoryBillingSettings {
  id                     String   @id @default(uuid()) @db.Uuid
  dormitoryId            String   @unique @map("dormitory_id") @db.Uuid
  billingDay             Int      @default(25) @map("billing_day")
  dueDay                 Int      @default(5) @map("due_day")
  waterBillingType       String   @default("per_unit") @map("water_billing_type") @db.VarChar(50)
  waterRate              Decimal  @default(18.00) @map("water_rate") @db.Decimal(12, 2)
  electricityBillingType String   @default("per_unit") @map("electricity_billing_type") @db.VarChar(50)
  electricityRate        Decimal  @default(7.00) @map("electricity_rate") @db.Decimal(12, 2)
  commonFee              Decimal  @default(0.00) @map("common_fee") @db.Decimal(12, 2)
  internetFee            Decimal  @default(0.00) @map("internet_fee") @db.Decimal(12, 2)
  lateFeeType            String   @default("fixed") @map("late_fee_type") @db.VarChar(50)
  lateFeeValue           Decimal  @default(50.00) @map("late_fee_value") @db.Decimal(12, 2)
  rentBillingType        String   @default("monthly") @map("rent_billing_type") @db.VarChar(50)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  dormitory              Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)

  @@map("dormitory_billing_settings")
}

model DormitoryPaymentSettings {
  id                         String   @id @default(uuid()) @db.Uuid
  dormitoryId                String   @unique @map("dormitory_id") @db.Uuid
  cashAccepted               Boolean  @default(true) @map("cash_accepted")
  promptPayType              String?  @map("prompt_pay_type") @db.VarChar(50)
  promptPayValueEncrypted    String?  @map("prompt_pay_value_encrypted") @db.Text
  promptPayValueMasked       String?  @map("prompt_pay_value_masked") @db.VarChar(255)
  bankCode                   String?  @map("bank_code") @db.VarChar(50)
  bankAccountName            String?  @map("bank_account_name") @db.VarChar(255)
  bankAccountNumberEncrypted String?  @map("bank_account_number_encrypted") @db.Text
  bankAccountNumberMasked    String?  @map("bank_account_number_masked") @db.VarChar(255)
  encryptionKeyVersion       Int      @default(1) @map("encryption_key_version")
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  dormitory                  Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)

  @@map("dormitory_payment_settings")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  dormitoryId String?  @map("dormitory_id") @db.Uuid
  code        String   @db.VarChar(50) // OWNER, MANAGER, FINANCE, STAFF, TECH
  name        String   @db.VarChar(100)
  permissions Json     @map("permissions")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  dormitory   Dormitory? @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  members     DormitoryMember[]

  @@unique([dormitoryId, code], name: "dormitory_role_code_unique")
  @@map("roles")
}

model DormitoryMember {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  dormitoryId String    @map("dormitory_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  status      String    @default("active") @db.VarChar(50) // invited, active, suspended, revoked
  invitedAt   DateTime? @map("invited_at") @db.Timestamptz()
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz()
  suspendedAt DateTime? @map("suspended_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dormitory   Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, dormitoryId], name: "user_dormitory_unique")
  @@map("dormitory_members")
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  sessionIdHash String    @unique @map("session_id_hash") @db.VarChar(255)
  tokenVersion  Int       @default(1) @map("token_version")
  status        String    @default("active") @db.VarChar(50) // active, revoked, expired
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz()
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz()
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz()
  revokedReason String?   @map("revoked_reason") @db.VarChar(255)
  userAgentHash String?   @map("user_agent_hash") @db.VarChar(255)
  ipMetadata    String?   @map("ip_metadata") @db.VarChar(255)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model PlatformPlan {
  id                  String   @id @default(uuid()) @db.Uuid
  code                String   @unique @db.VarChar(50)
  name                String   @db.VarChar(100)
  monthlyPrice        Decimal  @map("monthly_price") @db.Decimal(12, 2)
  currency            String   @default("THB") @db.VarChar(10)
  vatIncluded         Boolean  @default(true) @map("vat_included")
  roomLimit           Int?     @map("room_limit")
  messageQuotaMonthly Int      @default(300) @map("message_quota_monthly")
  isActive            Boolean  @default(true) @map("is_active")
  displayOrder        Int      @default(0) @map("display_order")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  subscriptions       PlatformSubscription[]

  @@map("platform_plans")
}

model PlatformSubscription {
  id                     String    @id @default(uuid()) @db.Uuid
  dormitoryId            String    @map("dormitory_id") @db.Uuid
  planId                 String    @map("plan_id") @db.Uuid
  status                 String    @default("trialing") @db.VarChar(50) // trialing, active, past_due, suspended, cancelled, expired
  billingInterval        String    @default("monthly") @map("billing_interval") @db.VarChar(50)
  trialStartedAt         DateTime? @map("trial_started_at") @db.Timestamptz()
  trialEndsAt            DateTime? @map("trial_ends_at") @db.Timestamptz()
  currentPeriodStartedAt DateTime? @map("current_period_started_at") @db.Timestamptz()
  currentPeriodEndsAt    DateTime? @map("current_period_ends_at") @db.Timestamptz()
  cancelAtPeriodEnd      Boolean   @default(false) @map("cancel_at_period_end")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  dormitory              Dormitory    @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  plan                   PlatformPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("platform_subscriptions")
}

model PlatformPromoCode {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique @db.VarChar(50)
  codeNormalized  String   @unique @map("code_normalized") @db.VarChar(50)
  status          String   @default("active") @db.VarChar(50)
  trialBonusDays  Int      @default(0) @map("trial_bonus_days")
  validFrom       DateTime? @map("valid_from") @db.Timestamptz()
  validUntil      DateTime? @map("valid_until") @db.Timestamptz()
  maxRedemptions  Int?     @map("max_redemptions")
  redemptionCount Int      @default(0) @map("redemption_count")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  redemptions     PlatformPromoRedemption[]

  @@map("platform_promo_codes")
}

model PlatformPromoRedemption {
  id             String   @id @default(uuid()) @db.Uuid
  promoCodeId    String   @map("promo_code_id") @db.Uuid
  dormitoryId    String   @map("dormitory_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  bonusDays      Int      @map("bonus_days")
  redeemedAt     DateTime @default(now()) @map("redeemed_at") @db.Timestamptz()
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  promoCode      PlatformPromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, dormitoryId], name: "promo_dormitory_unique")
  @@map("platform_promo_redemptions")
}

model OnboardingDraft {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  version     Int      @default(1)
  currentStep String   @default("dormitory") @map("current_step") @db.VarChar(50)
  payload     Json
  expiresAt   DateTime @map("expires_at") @db.Timestamptz()
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("onboarding_drafts")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  operation      String   @db.VarChar(100)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(255)
  requestHash    String   @map("request_hash") @db.VarChar(255)
  status         String   @default("processing") @db.VarChar(50) // processing, completed, failed
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  resourceType   String?  @map("resource_type") @db.VarChar(100)
  resourceId     String?  @map("resource_id") @db.VarChar(255)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz()
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([userId, operation, idempotencyKey], name: "user_operation_idempotency_unique")
  @@map("idempotency_keys")
}

model Building {
  id           String    @id @default(uuid()) @db.Uuid
  dormitoryId  String    @map("dormitory_id") @db.Uuid
  name         String    @db.VarChar(255)
  code         String?   @db.VarChar(100)
  floorCount   Int       @default(1) @map("floor_count")
  description  String?   @db.Text
  status       String    @default("active") @db.VarChar(50)
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz()

  dormitory    Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  rooms        Room[]

  @@unique([dormitoryId, code], name: "dormitory_building_code_unique")
  @@unique([dormitoryId, name], name: "dormitory_building_name_unique")
  @@map("buildings")
}

model Room {
  id                       String    @id @default(uuid()) @db.Uuid
  dormitoryId              String    @map("dormitory_id") @db.Uuid
  buildingId               String?   @map("building_id") @db.Uuid
  roomNumber               String    @map("room_number") @db.VarChar(100)
  floor                    Int       @default(1)
  roomType                 String    @default("standard") @map("room_type") @db.VarChar(100)
  status                   String    @default("vacant") @db.VarChar(50)
  rentCycle                String    @default("monthly") @map("rent_cycle") @db.VarChar(50)
  monthlyRent              Decimal   @default(0.00) @map("monthly_rent") @db.Decimal(12, 2)
  termRent                 Decimal?  @map("term_rent") @db.Decimal(12, 2)
  dailyRent                Decimal?  @map("daily_rent") @db.Decimal(12, 2)
  depositAmount            Decimal   @default(0.00) @map("deposit_amount") @db.Decimal(12, 2)
  parkingFee               Decimal   @default(0.00) @map("parking_fee") @db.Decimal(12, 2)
  maximumOccupants         Int       @default(2) @map("maximum_occupants")
  waterMeterNumber         String?   @map("water_meter_number") @db.VarChar(100)
  electricityMeterNumber   String?   @map("electricity_meter_number") @db.VarChar(100)
  initialWaterReading      Decimal   @default(0.00) @map("initial_water_reading") @db.Decimal(12, 2)
  initialElectricityReading Decimal  @default(0.00) @map("initial_electricity_reading") @db.Decimal(12, 2)
  amenities                Json?     @map("amenities")
  images                   Json?     @map("images")
  notes                    String?   @db.Text
  currentTenantId          String?   @map("current_tenant_id") @db.Uuid
  currentContractId        String?   @map("current_contract_id") @db.Uuid
  version                  Int       @default(1)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt                DateTime? @map("deleted_at") @db.Timestamptz()

  dormitory                Dormitory  @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  building                 Building?  @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  contracts                Contract[]
  meterDevices             MeterDevice[]
  meterReadings            MeterReading[]
  meterReplacements         MeterReplacement[]
  bills                    Bill[]
  payments                 Payment[]
  receipts                 Receipt[]

  @@unique([dormitoryId, roomNumber], name: "dormitory_room_number_unique")
  @@map("rooms")
}

model Tenant {
  id                   String    @id @default(uuid()) @db.Uuid
  dormitoryId          String    @map("dormitory_id") @db.Uuid
  linkedUserId         String?   @map("linked_user_id") @db.Uuid
  tenantNumber         String    @map("tenant_number") @db.VarChar(100)
  firstName            String    @map("first_name") @db.VarChar(255)
  lastName             String?   @map("last_name") @db.VarChar(255)
  displayName          String    @map("display_name") @db.VarChar(255)
  phone                String    @db.VarChar(50)
  email                String?   @db.VarChar(255)
  nationalIdEncrypted  String?   @map("national_id_encrypted") @db.Text
  nationalIdMasked     String?   @map("national_id_masked") @db.VarChar(255)
  dateOfBirth          DateTime? @map("date_of_birth") @db.Date
  gender               String?   @db.VarChar(50)
  address              String?   @db.Text
  status               String    @default("active") @db.VarChar(50)
  photoUrl             String?   @map("photo_url") @db.Text
  petInfo              Json?     @map("pet_info")
  notes                String?   @db.Text
  version              Int       @default(1)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz()

  dormitory            Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  coOccupants          TenantCoOccupant[]
  emergencyContacts    TenantEmergencyContact[]
  vehicles             TenantVehicle[]
  contracts            Contract[]
  bills                Bill[]
  payments             Payment[]
  receipts             Receipt[]

  @@unique([dormitoryId, tenantNumber], name: "dormitory_tenant_number_unique")
  @@map("tenants")
}

model TenantCoOccupant {
  id                  String    @id @default(uuid()) @db.Uuid
  dormitoryId         String    @map("dormitory_id") @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  contractId          String?   @map("contract_id") @db.Uuid
  name                String    @db.VarChar(255)
  phone               String?   @db.VarChar(50)
  relationship        String?   @db.VarChar(100)
  nationalIdEncrypted String?   @map("national_id_encrypted") @db.Text
  nationalIdMasked    String?   @map("national_id_masked") @db.VarChar(255)
  dateOfBirth         DateTime? @map("date_of_birth") @db.Date
  status              String    @default("active") @db.VarChar(50)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz()

  dormitory           Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_co_occupants")
}

model TenantEmergencyContact {
  id           String   @id @default(uuid()) @db.Uuid
  dormitoryId  String   @map("dormitory_id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String   @db.VarChar(255)
  phone        String   @db.VarChar(50)
  relationship String   @db.VarChar(100)
  isPrimary    Boolean  @default(true) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  dormitory    Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_emergency_contacts")
}

model TenantVehicle {
  id           String    @id @default(uuid()) @db.Uuid
  dormitoryId  String    @map("dormitory_id") @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  type         String    @default("car") @db.VarChar(50)
  brand        String?   @db.VarChar(100)
  model        String?   @db.VarChar(100)
  color        String?   @db.VarChar(50)
  licensePlate String    @map("license_plate") @db.VarChar(100)
  province     String?   @db.VarChar(100)
  status       String    @default("active") @db.VarChar(50)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz()

  dormitory    Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_vehicles")
}

model Contract {
  id                       String    @id @default(uuid()) @db.Uuid
  dormitoryId              String    @map("dormitory_id") @db.Uuid
  contractNumber           String    @map("contract_number") @db.VarChar(100)
  roomId                   String    @map("room_id") @db.Uuid
  tenantId                 String    @map("tenant_id") @db.Uuid
  status                   String    @default("draft") @db.VarChar(50)
  startDate                DateTime  @map("start_date") @db.Date
  endDate                  DateTime  @map("end_date") @db.Date
  durationMonths           Int       @default(1) @map("duration_months")
  rentBillingType          String    @default("monthly") @map("rent_billing_type") @db.VarChar(50)
  rentAmount               Decimal   @default(0.00) @map("rent_amount") @db.Decimal(12, 2)
  depositAmount            Decimal   @default(0.00) @map("deposit_amount") @db.Decimal(12, 2)
  advancePaymentAmount     Decimal   @default(0.00) @map("advance_payment_amount") @db.Decimal(12, 2)
  terms                    String?   @db.Text
  tenantSignature          String?   @map("tenant_signature") @db.Text
