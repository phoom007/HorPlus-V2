# Server Environment Configuration Blueprint

NODE_ENV=development
PORT=3001
API_BASE_PATH=/api/v1
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/horplus
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=10000

# Google Identity Verification
GOOGLE_CLIENT_ID=horplus-test-google-client-id

# Session Encryption & Cookie Settings
SESSION_ENCRYPTION_KEY=YOUR_SESSION_ENCRYPTION_KEY
SESSION_TTL_SECONDS=86400
SESSION_COOKIE_NAME=horplus_session

# CSRF Token Protection
CSRF_SIGNING_KEY=YOUR_CSRF_SIGNING_KEY
CSRF_COOKIE_NAME=horplus_csrf

# Security Cookie Flags
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=false

# SlipOK Live Payment Verification
SLIPOK_BRANCH_ID=YOUR_SLIPOK_BRANCH_ID
SLIPOK_API_KEY=YOUR_SLIPOK_API_KEY

# HorPlus Platform Subscription PromptPay Receiver (Dev/Platform Package Payments)
HORPLUS_PLATFORM_PROMPTPAY_ID=0935098808
HORPLUS_PLATFORM_ACCOUNT_NAME=นายภูวนาท ทานาลาด
PROMPTPAY_ID=0935098808
PROMPTPAY_ACCOUNT_NAME=นายภูวนาท ทานาลาด
