{
  "name": "horplus-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "subscription:catalog:sync": "tsx src/scripts/subscription-catalog-sync.ts",
    "subscription:catalog:check": "tsx src/scripts/subscription-catalog-sync.ts --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^5.22.0",
    "@types/pngjs": "^6.0.5",
    "cors": "2.8.5",
    "decimal.js": "10.5.0",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "helmet": "8.0.0",
    "ioredis": "5.4.2",
    "multer": "^2.2.0",
    "pdf-lib": "^1.17.1",
    "pino": "9.6.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "uuid": "11.0.5",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "6.0.2",
    "@types/uuid": "10.0.0",
    "jsqr": "^1.4.0",
    "pino-pretty": "13.0.0",
    "prisma": "^5.22.0",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.8.2",
    "vitest": "3.0.4"
  }
}
