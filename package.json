{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=5173 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run src/tests --environment happy-dom",
    "dev:api": "npm --prefix server run dev",
    "build:api": "npm --prefix server run build",
    "lint:api": "npm --prefix server run lint",
    "test:api": "npm --prefix server run test",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f",
    "uat:infra:up": "docker compose -f docker-compose.windows-pilot.yml up -d db redis",
    "uat:infra:status": "docker compose -f docker-compose.windows-pilot.yml ps",
    "uat:refresh": "tsx scripts/local07/refresh.mjs",
    "uat:reset": "tsx scripts/local07/reset.mjs",
    "uat:seed": "tsx scripts/local07/seed.mjs",
    "uat:verify": "tsx scripts/local07/verify.mjs",
    "uat:login": "tsx scripts/local07/login-helper.mjs",
    "uat:open": "tsx scripts/local07/open-browser.mjs",
    "uat:open:register": "tsx scripts/local07/open-browser.mjs registration-owner",
    "uat:open:fresh": "tsx scripts/local07/open-browser.mjs fresh-owner",
    "uat:open:owner": "tsx scripts/local07/open-browser.mjs comp-owner",
    "uat:open:tenant": "tsx scripts/local07/open-browser.mjs tenant-somchai",
    "uat:open:manager": "tsx scripts/local07/open-browser.mjs manager",
    "uat:open:tech": "tsx scripts/local07/open-browser.mjs tech",
    "uat:golden:ensure": "tsx scripts/local07/golden-ensure.mjs",
    "uat:golden:billing:ensure": "tsx scripts/local07/golden-billing-ensure.mjs",
    "uat:golden:verify": "tsx scripts/local07/golden-verify.mjs",
    "uat:open:golden-owner": "tsx scripts/local07/open-browser.mjs golden-owner"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@react-oauth/google": "^0.13.5",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.101.4",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "happy-dom": "^17.1.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.0.4"
  }
}
