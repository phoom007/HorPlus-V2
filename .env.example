# HorPlus-V2 Local Development Environment Variables
NODE_ENV=development
PORT=3000
API_BASE_PATH=/api/v1
DATABASE_URL=postgresql://horplus:horplus_dev_password@127.0.0.1:5432/horplus?schema=public
REDIS_URL=redis://127.0.0.1:6379
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=10000

# Auth & Session Configuration
GOOGLE_CLIENT_ID=horplus-dev-google-client-id.apps.googleusercontent.com
SESSION_ENCRYPTION_KEY=dev_session_secret_key_32_chars_long_0001
SESSION_TTL_SECONDS=86400
SESSION_COOKIE_NAME=horplus_session
CSRF_SIGNING_KEY=dev_csrf_signing_key_16_chars_min
CSRF_COOKIE_NAME=horplus_csrf
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=false

# Field Encryption
FIELD_ENCRYPTION_KEY=dev_field_encryption_key_32_chars_long_0001
FIELD_ENCRYPTION_KEY_VERSION=1


# Storage & File Configuration
STORAGE_PROVIDER=local
PUBLIC_SLIP_BASE_URL=http://localhost:3000/api/v1/public/slips